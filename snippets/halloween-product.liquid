<label class="halloween-product" data-pick-card>
  <input class="halloween-pick" type="radio" name="{{ group }}" value="{{ product.id }}" data-pick>
  <span class="halloween-product-image">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
    {%- endif -%}
    {%- if discount -%}<span class="halloween-product-tag">{{ discount }}% off</span>{%- endif -%}
    <span class="halloween-check" aria-hidden="true">✓</span>
  </span>
  <span class="halloween-product-title">{{ product.title }}</span>
  {%- assign remaining = 100 | minus: discount | default: 100 -%}
  {%- if product.variants.size > 1 -%}
    <select class="halloween-variant" aria-label="Options for {{ product.title | escape }}" data-variant>
      {%- for variant in product.variants -%}
        {%- if variant.available -%}
          <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-title="{{ product.title | escape }} - {{ variant.title | escape }}">{{ variant.title }} · {% if discount %}{{ variant.price | times: remaining | divided_by: 100 | money }}{% else %}{{ variant.price | money }}{% endif %}</option>
        {%- endif -%}
      {%- endfor -%}
    </select>
  {%- else -%}
    {%- assign only_variant = product.selected_or_first_available_variant -%}
    <input type="hidden" value="{{ only_variant.id }}" data-price="{{ only_variant.price }}" data-title="{{ product.title | escape }}" data-variant>
  {%- endif -%}
  <span class="halloween-product-price">
    {%- if product.price_varies %}From {% endif -%}
    {%- if discount -%}
      <s>{{ product.price | money }}</s> {{ product.price | times: remaining | divided_by: 100 | money }}
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
  </span>
  <a class="halloween-product-link" href="{{ product.url }}">Details ↗</a>
</label>
