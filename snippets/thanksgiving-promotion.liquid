{%- if placement == 'announcement' -%}
  <a class="announcement-thanksgiving" href="{{ routes.all_products_collection_url }}"><strong>THANKSGIVING SALE</strong><span>5% off automatically at checkout</span></a>
{%- elsif placement == 'cart' -%}
  <aside class="checkout-sale-note" aria-label="Thanksgiving sale">
    <strong>Thanksgiving sale: 5% off</strong>
    <span>Automatically applied at checkout. No code needed.</span>
  </aside>
{%- else -%}
  <aside class="thanksgiving-promotion" aria-label="Thanksgiving sale">
    <div class="thanksgiving-promotion-copy">
      <p class="thanksgiving-promotion-label">THANKSGIVING SALE</p>
      <h2>Your next upgrade. <span>5% off.</span></h2>
      <p>Automatically applied at checkout. No code needed.</p>
    </div>
    <div class="thanksgiving-promotion-actions">
      <a class="button thanksgiving-shop" href="{{ routes.all_products_collection_url }}">Shop the sale <span aria-hidden="true">↗</span></a>
      {% render 'configurator-link' %}
    </div>
  </aside>
{%- endif -%}