<section class="collection-page">
  <div class="collection-heading">
    <div>
      <p class="eyebrow"><span>02</span> THE FULL GARAGE</p>
      <h1>{{ collection.title }}</h1>
    </div>
    <p class="collection-intro">{{ collection.description | strip_html | default: 'Parts, upgrades, and essentials for the next ride. Find your setup and get back out there.' }}</p>
  </div>

  <div class="collection-layout">
    <aside class="collection-sidebar" aria-label="Browse collections">
      <p class="eyebrow">COLLECTIONS</p>
      <nav aria-label="Collection categories">
        <a href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">00</span> All parts</a>
        <a href="{{ routes.collections_url }}/emoto-tires"{% if collection.handle == 'emoto-tires' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">01</span> Brakes</a>
        <a href="{{ routes.collections_url }}/emoto-wheels"{% if collection.handle == 'emoto-wheels' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">02</span> Wheels</a>
        <a href="{{ routes.collections_url }}/plug-and-play-emoto-lights"{% if collection.handle == 'plug-and-play-emoto-lights' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">03</span> Lights</a>
        <a href="{{ routes.collections_url }}/emoto-power-upgrades"{% if collection.handle == 'emoto-power-upgrades' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">04</span> Power up</a>
        <a href="{{ routes.collections_url }}/emoto-brakes"{% if collection.handle == 'emoto-brakes' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">05</span> Carbon fiber</a>
        <a href="{{ routes.collections_url }}/direct-stem"{% if collection.handle == 'direct-stem' %} aria-current="page"{% endif %}><span class="collection-sidebar-index">06</span> Stems + bars</a>
      </nav>
    </aside>
    <div class="collection-results">
  {% paginate collection.products by 12 %}
  {% if collection.products.size > 0 %}
    <div class="collection-product-grid">
      {% for product in collection.products %}
        <a class="collection-product favorite-card reveal" href="{{ product.url }}">
          <div class="favorite-image">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
            {% endif %}
            <span class="favorite-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="favorite-details"><div><h3>{{ product.title }}</h3><span>{{ product.type | default: 'Rider favorite' }}</span></div><strong>{{ product.price | money }}</strong></div>
          <span class="favorite-cta">View product <span aria-hidden="true">↗</span></span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p>Products coming soon.</p>
  {% endif %}

  {% if paginate.pages > 1 %}
    <nav class="collection-pagination" aria-label="Collection pages">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>
      {% endif %}
      {% for part in paginate.parts %}
        {% if part.is_link %}
          <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
        {% else %}
          <span{% if paginate.current_page == part.title %} aria-current="page"{% endif %}>{{ part.title }}</span>
        {% endif %}
      {% endfor %}
      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" aria-label="Next page">→</a>
      {% endif %}
    </nav>
  {% endif %}
  {% endpaginate %}
    </div>
  </div>
</section>
