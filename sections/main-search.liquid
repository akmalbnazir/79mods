<section class="search-results-page" aria-labelledby="search-results-title">
  {% paginate search.results by 24 %}
    <div class="search-results-heading">
      <div>
        <p class="eyebrow">SEARCH THE GARAGE</p>
        <h1 id="search-results-title">
          {% if search.performed %}Search results{% else %}Find your parts{% endif %}
        </h1>
      </div>
      {% if search.performed %}
        <p role="status">{{ search.results_count }} {% if search.results_count == 1 %}product{% else %}products{% endif %} for “{{ search.terms | escape }}”</p>
      {% endif %}
    </div>

    <form class="search-results-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="shop-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.3 4.3"></path></svg>
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search parts, bikes, and upgrades" aria-label="Search products" required>
      </label>
      <input type="hidden" name="type" value="product">
    </form>

    {% if search.performed %}
      {% if search.results.size > 0 %}
        <div class="collection-product-grid">
          {% for product in search.results %}
            <a class="collection-product favorite-card reveal" href="{{ product.url }}">
              <div class="favorite-image">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
                {% endif %}
                <span class="favorite-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="favorite-details"><div><h3>{{ product.title }}</h3><span>{{ product.type | default: 'Rider favorite' }}</span></div><strong>{{ product.price | money }}</strong></div>
              <span class="favorite-cta">View product <span aria-hidden="true">↗</span></span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <p class="search-results-empty">No products found for “{{ search.terms | escape }}”. Try another search or <a href="{{ routes.all_products_collection_url }}">browse all parts</a>.</p>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="collection-pagination" aria-label="Search result pages">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>
            {% else %}
              <span{% if paginate.current_page == part.title %} aria-current="page"{% endif %}>{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" aria-label="Next page">→</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
