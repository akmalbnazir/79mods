<header class="site-header" id="top">
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="79mods home"><img src="{{ '79mods_png.avif' | asset_url }}" alt="79mods logo"></a>
  <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
    <a href="{{ routes.all_products_collection_url }}">Shop parts</a>
  </nav>
  <div class="header-actions">
    <button class="collections-toggle" type="button" aria-label="Open collections" aria-expanded="false" aria-controls="collection-drawer" title="Browse collections">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path><circle cx="7" cy="6" r="1"></circle><circle cx="7" cy="12" r="1"></circle><circle cx="7" cy="18" r="1"></circle></svg>
      <span>Collections</span>
    </button>
    <button class="search-toggle" type="button" aria-label="Focus search" title="Search parts">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.3 4.3"></path></svg>
      <span>Search</span>
    </button>
    <a class="bag-link" href="{{ routes.cart_url }}" aria-label="Open shopping bag">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Z"></path><path d="M9 9V6a3 3 0 0 1 6 0v3"></path></svg>
      <span>Bag <b>↗</b></span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span></button>
  </div>
</header>
