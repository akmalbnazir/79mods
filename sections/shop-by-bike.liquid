{%- assign bike_handles = 'surron-parts,79bike-parts,ventus-parts,e-ride-parts,talaria-parts' | split: ',' -%}
<section class="bike-section" aria-labelledby="bike-title">
  <div class="favorites-heading reveal">
    <div>
      <p class="eyebrow"><span>03</span> SHOP BY BIKE</p>
      <h2 id="bike-title">FIND YOUR<br><em>RIDE.</em></h2>
    </div>
    <a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all parts <span aria-hidden="true">↗</span></a>
  </div>

  <div class="favorites-grid bike-grid">
    {%- for handle in bike_handles -%}
      {%- assign bike = collections[handle] -%}
      {%- assign bike_image = bike.image | default: bike.products[forloop.index0].featured_image -%}
      <a class="favorite-card bike-card reveal" href="{{ bike.url }}">
        <div class="favorite-image">
          {%- if bike_image -%}
            <img src="{{ bike_image | image_url: width: 700 }}" alt="{{ bike.title | escape }}" loading="lazy">
          {%- endif -%}
          <span class="favorite-index">{{ forloop.index | prepend: '0' }} / BIKE</span>
          <span class="favorite-arrow" aria-hidden="true">↗</span>
        </div>
        <div class="favorite-details"><div><h3>{{ bike.title }}</h3><span>{{ bike.products_count }} parts</span></div></div>
        <span class="favorite-cta">Shop parts <span aria-hidden="true">↗</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>
